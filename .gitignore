# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.cover

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Secrets & certificates (never commit real keys)
certs/*.crt
certs/*.key
certs/*.pem
!certs/.gitkeep
.env
.env.*
!.env.example

# Data artifacts (regenerate via scripts)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# MLflow local artifacts
mlruns/
mlartifacts/

# OS
.DS_Store
Thumbs.db

# Docker volumes
vault/data/
vault/logs/
