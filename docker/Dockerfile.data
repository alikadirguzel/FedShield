FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY docker/requirements.data.txt /tmp/requirements.txt
RUN pip install --upgrade pip \
    && pip install -r /tmp/requirements.txt

COPY scripts/generate_non_iid_data.py /app/generate_non_iid_data.py

ENTRYPOINT ["python", "/app/generate_non_iid_data.py"]
CMD ["--isolated-root", "/out"]
