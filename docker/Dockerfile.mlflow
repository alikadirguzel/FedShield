FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip \
    && pip install mlflow==2.11.3 gunicorn==21.2.0

COPY docker/mlflow_wsgi.py /app/mlflow_wsgi.py

RUN useradd --create-home --uid 10001 mlflow \
    && mkdir -p /mlflow/artifacts \
    && chown -R mlflow:mlflow /mlflow /app

# Start as root so the named volume can be re-owned, then gunicorn drops to mlflow.
# Docker Desktop often creates /mlflow as root:root (mode 755), which makes sqlite read-only.
CMD ["sh", "-c", "mkdir -p /mlflow/artifacts && chown -R mlflow:mlflow /mlflow && exec gunicorn --user mlflow --group mlflow --bind 0.0.0.0:5000 --workers 1 --threads 4 --timeout 120 mlflow_wsgi:app"]
