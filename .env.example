# FedShield environment template — copy to .env
# Vault root token is consumed only by vault-init. FL clients/server never see it.
VAULT_TOKEN=fedshield-dev-root-token

# MLflow basic auth (required). Change the password before any shared deployment.
MLFLOW_TRACKING_USERNAME=fedshield
MLFLOW_TRACKING_PASSWORD=fedshield-mlflow-change-me
MLFLOW_TRACKING_URI=http://mlflow:5000

# Set true only for local unit tests without Vault
FEDSHIELD_DEV_CERTS=false
GRPC_MAX_MESSAGE_LENGTH=33554432
