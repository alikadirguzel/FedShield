# Copy to .env (python scripts/init_env.py). Never commit .env.
#
# MLFLOW_BIND=127.0.0.1  → only this machine
# MLFLOW_BIND=0.0.0.0    → all interfaces (VPS / public URL)

MLFLOW_TRACKING_USERNAME=fedshield
MLFLOW_TRACKING_PASSWORD=REPLACE_ME
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BIND=127.0.0.1
MLFLOW_PORT=5000

FEDSHIELD_DEV_CERTS=false
GRPC_MAX_MESSAGE_LENGTH=33554432
